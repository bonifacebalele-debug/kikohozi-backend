DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# PostgreSQL (used in production)
DATABASE_URL=postgres://user:password@localhost:5432/kikohozi

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — allow the mobile app's local dev origin if testing via browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Media files (audio uploads)
MEDIA_ROOT=/var/www/kikohozi/media
